---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import MetricStrip from '../components/MetricStrip.astro';
import InteractiveShowcase from '../components/InteractiveShowcase.astro';
import Capabilities from '../components/Capabilities.astro';
import Herd from '../components/Herd.astro';
import AntiFeatures from '../components/AntiFeatures.astro';
import Tiers from '../components/Tiers.astro';
import InstallCTA from '../components/InstallCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
