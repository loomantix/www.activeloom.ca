>
  <Nav />
  <main class="grow">
    <Hero />
    <MetricStrip />
    <Capabilities />
    <Herd />
    <InteractiveShowcase />
    <AntiFeatures />
    <Tiers />
    <InstallCTA />
  </main>
  <Footer />
</Layout>
