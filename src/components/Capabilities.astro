---
---

<section id="capabilities" class="py-16 sm:py-24 border-b border-[var(--loom-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <div class="text-xs font-mono uppercase tracking-widest text-[var(--loom-accent)] mb-2">Capabilities</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight">
        Engineered for teams that treat agent code like production code.
      </h2>
      <p class="text-base sm:text-lg text-[var(--loom-muted)] mt-4">
        ActiveLoom replaces fragile ad-hoc system prompts with structured engineering discipline, rigorous review ledgers, and deterministic fleet sync.
      </p>
    </div>

    <!-- How the parts fit together -->
    <div class="mb-12 p-5 sm:p-6 rounded-xl border border-[var(--loom-border-active)] bg-[var(--loom-code)]">
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--loom-text)] font-semibold mb-4">How it fits together</div>
      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-sm text-[var(--loom-muted)]">
        <li><span class="font-mono text-[var(--loom-accent)] font-bold">1 · Skills</span><br />The base. Install any one on its own: interviews, debugging, issue work, review.</li>
        <li><span class="font-mono text-[var(--loom-amber)] font-bold">2 · Review protocol</span><br />Review skills post findings on a draft PR before fixing, and record them in a ledger pinned to the commit.</li>
        <li><span class="font-mono text-[var(--loom-cyan)] font-bold">3 · Automation</span><br /><code class="text-[var(--loom-text)]">agent-loop</code> works an allowlisted issue queue headlessly. The optional <a href="#herd" class="underline underline-offset-4 hover:text-[var(--loom-text)]">herd skills</a> run the same reviews, interviews, and builds in terminal panes you watch.</li>
        <li><span class="font-mono text-[var(--loom-coral)] font-bold">4 · Sync</span><br />Keeps all of it current across your repositories through pull requests, without touching your local rules.</li>
      </ol>
    </div>

    <!-- Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 01 Reusable Engineering Skills -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-accent)] font-bold text-sm">01</span>
            <span>SKILLS & WORKFLOWS</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Not chat prompts. Operational skills.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            ActiveLoom skills encode strict operational procedures with validation checklists and deterministic outputs. From product and design interviews (<code class="text-[var(--loom-text)]">product-grill</code>, <code class="text-[var(--loom-text)]">grill</code>) and deep troubleshooting (<code class="text-[var(--loom-text)]">diagnosing-bugs</code>) to agent-ready backlogs (<code class="text-[var(--loom-text)]">backlog-refinement</code>) and pre-merge red teams (<code class="text-[var(--loom-text)]">red-team</code>).
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono text-[var(--loom-muted)] space-y-1.5">
          <div class="flex items-center justify-between text-[var(--loom-text)] font-semibold">
            <span>/diagnosing-bugs</span>
            <span class="text-[var(--loom-accent)]">READY</span>
          </div>
          <div class="text-[11px] text-[var(--loom-muted)]">Step 1: Reproduce defect in isolation</div>
          <div class="text-[11px] text-[var(--loom-muted)]">Step 2: Root cause analysis (no guessing)</div>
          <div class="text-[11px] text-[var(--loom-accent)]">Step 3: Smallest meaningful fix + regression test</div>
        </div>
      </div>

      <!-- 02 Tri-Engine Parity -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-cyan)] font-bold text-sm">02</span>
            <span>MULTI-ENGINE PARITY</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Claude, Codex, and Gemini in sync.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            Don't maintain three divergent prompt trees. Shared skills are authored once in <code class="text-[var(--loom-text)]">prompts/</code> and rendered into <code class="text-[var(--loom-cyan)]">.claude/</code>, <code class="text-[var(--loom-cyan)]">.codex/</code>, and <code class="text-[var(--loom-cyan)]">.agents/</code> (Gemini / Antigravity). Review prompts are tuned per engine on purpose.
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono space-y-2">
          <div class="flex items-center justify-between text-[var(--loom-muted)] text-[11px]">
            <span>One upstream definition</span>
            <span class="text-[var(--loom-cyan)] font-bold">3 native outputs</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5 text-center text-[10px]">
            <div class="p-1.5 rounded bg-[var(--loom-subpanel)] border border-[var(--loom-border)] text-[var(--loom-text)] font-semibold">Claude Code</div>
            <div class="p-1.5 rounded bg-[var(--loom-subpanel)] border border-[var(--loom-border)] text-[var(--loom-text)] font-semibold">OpenAI Codex</div>
            <div class="p-1.5 rounded bg-[var(--loom-subpanel)] border border-[var(--loom-border)] text-[var(--loom-text)] font-semibold">Gemini / Agy</div>
          </div>
        </div>
      </div>

      <!-- 03 PR-First Adversarial Review -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-amber)] font-bold text-sm">03</span>
            <span>REVIEW PROTOCOL</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Adversarial review. Proof before edit.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            No rubber-stamping. Reviewers inspect the draft PR diff and post verified findings inline on GitHub <em>before</em> touching any code. Each PR's review depth is resolved first: <strong>Lean</strong> runs the highest-signal lenses; <strong>Deep</strong> runs the full matrix for risky surfaces such as auth or crypto.
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono space-y-1.5">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[var(--loom-muted)]">Review depth:</span>
            <span class="text-[var(--loom-amber)] font-bold">Deep</span>
          </div>
          <div class="text-[10px] text-[var(--loom-muted)]">Trigger: auth &amp; crypto boundaries</div>
          <div class="text-[10px] text-[var(--loom-accent)] font-semibold">✓ Findings posted inline before code fix</div>
        </div>
      </div>

      <!-- 04 Verifiable Commit Ledgers -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-accent)] font-bold text-sm">04</span>
            <span>REVIEW LEDGER</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Review evidence pinned to the commit.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            Every review pass is recorded on the draft PR as ledger markers carrying sha256 digests and the exact head commit. Push a new commit and attestations for the old head stop counting.
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-[var(--loom-muted)] text-[11px]">PR ledger · verify-coverage</span>
            <span class="text-[var(--loom-accent)] font-bold text-[10px]">HEAD MATCHED</span>
          </div>
          <div class="text-[10px] text-[var(--loom-muted)] truncate">head=4d2e1b89ef01a23c7b89...</div>
          <div class="text-[10px] text-[var(--loom-accent)] font-semibold">✓ Attested by Codex + Gemini reviewers</div>
        </div>
      </div>

      <!-- 05 Bounded Autonomous Issue Execution -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-cyan)] font-bold text-sm">05</span>
            <span>BOUNDED AUTONOMY</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Autonomous queues with guardrails.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            Let agents work your GitHub backlog safely with <code class="text-[var(--loom-text)]">agent-loop</code>. Strict issue allowlists, one linked Git worktree and draft PR per issue (<code class="text-[var(--loom-cyan)]">agent-loop/issue-&lt;N&gt;-&lt;run&gt;</code>), bounded local review rounds, fresh-base validation, and automatic bail-outs when blocked. <a href="https://github.com/loomantix/activeloom/blob/main/docs/autonomous-development.md" target="_blank" rel="noreferrer" class="text-[var(--loom-text)] underline underline-offset-4">Setup guide ↗</a>
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono space-y-1.5">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[var(--loom-text)] font-semibold">CLI Tape Demo:</span>
            <span class="text-[var(--loom-cyan)] font-mono">LIVE</span>
          </div>
          <div class="text-[11px] text-[var(--loom-cyan)] truncate font-semibold">
            $ <span id="tape-demo-text"></span><span class="terminal-cursor"></span>
          </div>
        </div>
      </div>

      <!-- 06 Upstream Fleet Distribution & Sync -->
      <div class="p-6 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
        <div>
          <div class="flex items-center justify-between text-xs font-mono text-[var(--loom-muted)] mb-4">
            <span class="text-[var(--loom-coral)] font-bold text-sm">06</span>
            <span>FLEET DISTRIBUTION</span>
          </div>
          <h3 class="text-xl font-bold font-display mb-2">Sync every repo without losing local rules.</h3>
          <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-6">
            A scheduled GitHub Actions workflow proposes skill and review updates as pull requests from the upstream's <code class="text-[var(--loom-text)]">sync-v2</code> release ref, while protecting repo-owned rules such as <code class="text-[var(--loom-coral)]">.review/addendum.local.md</code>. <a href="https://github.com/loomantix/activeloom/blob/main/docs/sync.md" target="_blank" rel="noreferrer" class="text-[var(--loom-text)] underline underline-offset-4">How sync works ↗</a>
          </p>
        </div>
        <div class="p-3 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] text-xs font-mono space-y-1.5">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-[var(--loom-muted)]">Upstream: activeloom@sync-v2</span>
            <span class="text-[var(--loom-accent)] font-semibold">PR opened</span>
          </div>
          <div class="text-[10px] text-[var(--loom-muted)]">Syncs: Core skills, review workflows</div>
          <div class="text-[10px] text-[var(--loom-accent)] font-semibold">★ Local addenda & project rules strictly preserved</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const tapeText = document.getElementById('tape-demo-text');
    if (!tapeText) return;

    const LINES = [
      'npx activeloom detect',
      'npx activeloom add critique --harness claude',
      'pnpm test -- tests/allocator.spec.ts',
      'npx activeloom add hreview horch --harness claude',
      'git push -u origin fix/allocator-floor',
    ];

    let lineIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function tick() {
      const current = LINES[lineIdx];
      if (!isDeleting) {
        charIdx++;
        tapeText.textContent = current.substring(0, charIdx);
        if (charIdx >= current.length) {
          isDeleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 40 + Math.random() * 30);
      } else {
        charIdx -= 2;
        tapeText.textContent = current.substring(0, Math.max(0, charIdx));
        if (charIdx <= 0) {
          isDeleting = false;
          lineIdx = (lineIdx + 1) % LINES.length;
          setTimeout(tick, 300);
          return;
        }
        setTimeout(tick, 20);
      }
    }

    tick();
  })();
</script>
