---
// Mirrors the skill table in loomantix/activeloom docs/herd-orchestration.md.
const SKILLS = [
  {
    name: 'horch',
    tag: 'ORCHESTRATOR',
    color: 'var(--loom-accent)',
    does: 'Orchestrates a whole herdr workspace: starts review chains, builds, grills and promotions in tabs, and ships converged work to the integration branch.',
    stops: 'A ship gate fails, a chain blocks, or a call is yours.',
  },
  {
    name: 'hreview',
    tag: 'REVIEW CHAIN',
    color: 'var(--loom-amber)',
    does: 'Runs the ordinary review chain on a PR, one engine per pane, until it converges or runs out of rounds.',
    stops: 'It converged (the merge is yours), or it is blocked.',
  },
  {
    name: 'hgrill',
    tag: 'INTERVIEWS',
    color: 'var(--loom-cyan)',
    does: 'Grills an issue on each configured engine in turn, then posts the biggest product calls and assumptions to the issue.',
    stops: 'Always: the assumptions block waits for your sign-off.',
  },
  {
    name: 'hloop',
    tag: 'BATCH BUILDS',
    color: 'var(--loom-cyan)',
    does: 'Runs a batch of agent-ready issues: a build tab per issue, then a fresh review chain, then a ship through horch’s gate.',
    stops: 'An issue’s design is open, a gate fails, or a chain blocks.',
  },
  {
    name: 'hred-team',
    tag: 'RED TEAM',
    color: 'var(--loom-coral)',
    does: 'Red-teams a reviewed PR in a read-only pane. The author engine fixes blocker and high findings; the rest become issues.',
    stops: 'It pushed fixes (the chain needs a restart), or a high finding stayed unfixed.',
  },
  {
    name: 'hpromote',
    tag: 'PROMOTION',
    color: 'var(--loom-amber)',
    does: 'Runs your repository’s promotion recipe across at most six visible panes, with a read-only risk review and fix lanes.',
    stops: 'The promotion PR is ready: approving and merging it is yours.',
  },
  {
    name: 'auto-glance',
    tag: 'OPT-IN GLANCE',
    color: 'var(--loom-muted)',
    does: 'Puts one non-author model in the seat of the human glance for small or docs-only PRs. Opt-in per repository.',
    stops: 'The read found something, or CI is red.',
  },
];
---

<section id="herd" class="py-16 sm:py-24 border-b border-[var(--loom-border)] bg-[var(--loom-panel)]/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12">
      <div class="lg:col-span-7">
        <div class="text-xs font-mono uppercase tracking-widest text-[var(--loom-accent)] mb-2">Herd Orchestration</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight">
          One session drives the herd. You watch every pane.
        </h2>
        <p class="text-base sm:text-lg text-[var(--loom-muted)] mt-4">
          The herd skills let one agent session drive other agent sessions in visible
          <a href="https://herdr.dev" target="_blank" rel="noreferrer" class="text-[var(--loom-text)] underline decoration-[var(--loom-border-active)] underline-offset-4 hover:decoration-[var(--loom-accent)]">herdr</a>
          panes. Every review pass, grill interview, and build runs where you can see it, and you can type into any pane to step in.
          Any of the three harnesses can drive, and any of them can be driven.
        </p>
      </div>
      <div class="lg:col-span-5 flex flex-col justify-end gap-3 text-sm text-[var(--loom-muted)]">
        <div class="p-4 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] font-mono text-xs space-y-1.5">
          <div class="text-[var(--loom-text)] font-semibold">Not a second evidence system</div>
          <div>Each pass is the engine’s ordinary interactive review, recorded in the PR ledger exactly as if you ran it yourself. Tiers, round caps, convergence, and attestations are unchanged.</div>
        </div>
        <div class="p-4 rounded-lg border border-[var(--loom-border)] bg-[var(--loom-code)] font-mono text-xs space-y-1.5">
          <div class="text-[var(--loom-text)] font-semibold">It stops for the calls that are yours</div>
          <div>Merging to production, product calls, and anything it cannot do safely.</div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {SKILLS.map((s) => (
        <div class="p-5 rounded-xl border border-[var(--loom-border)] bg-[var(--loom-panel)] flex flex-col justify-between hover:border-[var(--loom-border-active)] transition-all">
          <div>
            <div class="flex items-center justify-between text-[10px] font-mono text-[var(--loom-muted)] mb-3">
              <code class="text-sm font-bold" style={`color: ${s.color}`}>{s.name}</code>
              <span class="uppercase tracking-wider">{s.tag}</span>
            </div>
            <p class="text-sm text-[var(--loom-muted)] leading-relaxed mb-4">{s.does}</p>
          </div>
          <div class="pt-3 border-t border-[var(--loom-border)] text-[11px] font-mono text-[var(--loom-muted)]">
            <span class="text-[var(--loom-text)] font-semibold">Stops for you:</span> {s.stops}
          </div>
        </div>
      ))}

      <div class="p-5 rounded-xl border border-[var(--loom-border-active)] bg-[var(--loom-code)] flex flex-col justify-between font-mono text-xs">
        <div class="space-y-2 text-[var(--loom-muted)]">
          <div class="text-[var(--loom-text)] font-semibold text-sm">Get started</div>
          <div>Needs herdr 0.9.0+, an authenticated <code class="text-[var(--loom-text)]">gh</code>, the review profile, and the Codex harness installed.</div>
        </div>
        <div class="mt-4 space-y-2">
          <div class="p-2 rounded bg-[var(--loom-panel)] border border-[var(--loom-border)] text-[var(--loom-accent)] break-words">$ npx activeloom add hreview horch --harness claude</div>
          <a href="https://github.com/loomantix/activeloom/blob/main/docs/herd-orchestration.md" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-[var(--loom-text)] hover:text-[var(--loom-accent)] transition-colors">
            Read the herd guide ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
