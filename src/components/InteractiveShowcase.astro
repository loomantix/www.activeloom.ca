---
---

<section id="showcase" class="py-16 sm:py-20 border-b border-[var(--loom-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
      <div>
        <div class="text-xs font-mono uppercase tracking-widest text-[var(--loom-accent)] mb-1">Live Protocol Simulator</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display">A herd workspace in action.</h2>
      </div>
      <p class="text-xs font-mono text-[var(--loom-muted)]">
        Click any tab or agent to inspect what each pane is doing ↗
      </p>
    </div>

    <!-- The Mock TUI Frame -->
    <div class="rounded-xl border border-[var(--loom-border-active)] bg-[var(--loom-code)] shadow-2xl overflow-hidden">
      <!-- Window Titlebar -->
      <div class="h-10 px-4 border-b border-[var(--loom-border)] bg-[var(--loom-panel)] flex items-center justify-between text-xs font-mono text-[var(--loom-muted)]">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          <span class="ml-2 text-[var(--loom-text)] font-semibold">herdr — api-gateway · driven by horch</span>
        </div>
        <div class="hidden sm:flex items-center gap-4">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[var(--loom-accent)] live-pulse"></span> protocol: converged</span>
          <span>integration: staging</span>
        </div>
      </div>

      <!-- Main Layout: Sidebar + Terminal -->
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[540px]">
        <!-- Sidebar (Spaces & Agents) -->
        <aside class="lg:col-span-3 border-b lg:border-b-0 lg:border-r border-[var(--loom-border)] bg-[var(--loom-panel)]/50 p-3 flex flex-col gap-5 text-xs font-mono">
          <!-- Workspaces -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--loom-muted)] px-2 mb-2">horch tabs</div>
            <div class="flex flex-col gap-1">
              <button
                type="button"
                data-mock-space="critique"
                class="mock-nav-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2.5 transition-all bg-[var(--loom-subpanel)] text-[var(--loom-text)] font-medium border border-[var(--loom-border-active)]"
              >
                <span class="w-2 h-2 rounded-full bg-[var(--loom-amber)]"></span>
                <div class="truncate">
                  <div class="font-bold">hreview</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">PR #57 · round 2</div>
                </div>
              </button>

              <button
                type="button"
                data-mock-space="loop"
                class="mock-nav-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2.5 transition-all text-[var(--loom-muted)] hover:text-[var(--loom-text)] hover:bg-[var(--loom-subpanel)]/50 border border-transparent"
              >
                <span class="w-2 h-2 rounded-full bg-[var(--loom-cyan)]"></span>
                <div class="truncate">
                  <div class="font-bold">hloop</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">3 issues · 2 shipped</div>
                </div>
              </button>

              <button
                type="button"
                data-mock-space="grill"
                class="mock-nav-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2.5 transition-all text-[var(--loom-muted)] hover:text-[var(--loom-text)] hover:bg-[var(--loom-subpanel)]/50 border border-transparent"
              >
                <span class="w-2 h-2 rounded-full bg-[var(--loom-accent)]"></span>
                <div class="truncate">
                  <div class="font-bold">hgrill</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">issue #91 · awaiting you</div>
                </div>
              </button>
            </div>
          </div>

          <!-- Agents -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--loom-muted)] px-2 mb-2">Panes</div>
            <div class="flex flex-col gap-1">
              <button
                type="button"
                data-mock-agent="critique"
                class="mock-agent-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2 transition-all bg-[var(--loom-subpanel)] text-[var(--loom-text)]"
              >
                <span class="text-[var(--loom-amber)]">●</span>
                <div class="truncate">
                  <div class="font-semibold">Codex</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">critique deep · finding</div>
                </div>
              </button>

              <button
                type="button"
                data-mock-agent="ledger"
                class="mock-agent-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2 transition-all text-[var(--loom-muted)] hover:text-[var(--loom-text)]"
              >
                <span class="text-[var(--loom-accent)]">◉</span>
                <div class="truncate">
                  <div class="font-semibold">Gemini / Agy</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">ledger verification</div>
                </div>
              </button>

              <button
                type="button"
                data-mock-agent="loop"
                class="mock-agent-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2 transition-all text-[var(--loom-muted)] hover:text-[var(--loom-text)]"
              >
                <span class="text-[var(--loom-cyan)]">●</span>
                <div class="truncate">
                  <div class="font-semibold">Claude · horch</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">driving session</div>
                </div>
              </button>

              <button
                type="button"
                data-mock-agent="sync"
                class="mock-agent-btn w-full text-left px-2.5 py-2 rounded flex items-center gap-2 transition-all text-[var(--loom-muted)] hover:text-[var(--loom-text)]"
              >
                <span class="text-[var(--loom-muted)]">○</span>
                <div class="truncate">
                  <div class="font-semibold">sync-engine v2</div>
                  <div class="text-[10px] text-[var(--loom-muted)]">upstream scheduler</div>
                </div>
              </button>
            </div>
          </div>
        </aside>

        <!-- Main Terminal Area -->
        <main class="lg:col-span-9 flex flex-col justify-between bg-[var(--loom-code)]">
          <!-- Terminal Tabs -->
          <div role="tablist" aria-label="herd workspace tabs" class="flex items-center border-b border-[var(--loom-border)] bg-[var(--loom-panel)]/30 text-xs font-mono overflow-x-auto">
            <button
              type="button"
              role="tab"
              id="tab-critique"
              aria-selected="true"
              aria-controls="pane-critique"
              data-mock-tab="critique"
              class="tab-btn px-4 py-2.5 border-r border-[var(--loom-border)] border-b-2 border-b-[var(--loom-accent)] bg-[var(--loom-code)] text-[var(--loom-text)] font-semibold flex items-center gap-2 whitespace-nowrap"
            >
              <span>1. hreview #57</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--loom-amber)]"></span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-ledger"
              aria-selected="false"
              aria-controls="pane-ledger"
              data-mock-tab="ledger"
              class="tab-btn px-4 py-2.5 border-r border-[var(--loom-border)] border-b-2 border-b-transparent text-[var(--loom-muted)] hover:text-[var(--loom-text)] flex items-center gap-2 whitespace-nowrap"
            >
              <span>2. PR ledger</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--loom-accent)]"></span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-grill"
              aria-selected="false"
              aria-controls="pane-grill"
              data-mock-tab="grill"
              class="tab-btn px-4 py-2.5 border-r border-[var(--loom-border)] border-b-2 border-b-transparent text-[var(--loom-muted)] hover:text-[var(--loom-text)] flex items-center gap-2 whitespace-nowrap"
            >
              <span>3. hgrill #91</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--loom-amber)]"></span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-loop"
              aria-selected="false"
              aria-controls="pane-loop"
              data-mock-tab="loop"
              class="tab-btn px-4 py-2.5 border-r border-[var(--loom-border)] border-b-2 border-b-transparent text-[var(--loom-muted)] hover:text-[var(--loom-text)] flex items-center gap-2 whitespace-nowrap"
            >
              <span>4. hloop batch</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--loom-cyan)]"></span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-sync"
              aria-selected="false"
              aria-controls="pane-sync"
              data-mock-tab="sync"
              class="tab-btn px-4 py-2.5 border-r border-[var(--loom-border)] border-b-2 border-b-transparent text-[var(--loom-muted)] hover:text-[var(--loom-text)] flex items-center gap-2 whitespace-nowrap"
            >
              <span>5. sync-v2 (Fleet)</span>
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            </button>
          </div>

          <!-- Terminal Content Panes -->
          <div class="p-5 font-mono text-xs sm:text-[13px] leading-relaxed overflow-x-auto grow">
            <!-- Pane 1: hreview -->
            <div id="pane-critique" role="tabpanel" aria-labelledby="tab-critique" class="tab-pane block space-y-3">
              <div class="text-[var(--loom-muted)]">
                <span class="text-[var(--loom-cyan)] font-bold">hreview</span> herding <span class="text-[var(--loom-text)] font-semibold">PR #57</span> &gt; <span class="text-[var(--loom-amber)]">feat/session-refresh</span> &middot; pane 2 of 3: <span class="text-[var(--loom-text)]">Codex</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[var(--loom-accent)] font-bold">❯</span>
                <span class="text-[var(--loom-text)] font-semibold">/critique deep</span>
              </div>
              <div class="text-[var(--loom-muted)] pl-4 border-l border-[var(--loom-border)] space-y-1">
                <div>[protocol] Draft PR #57 found. Review tier resolved: <span class="text-[var(--loom-amber)] font-bold">DEEP</span> (Trigger: auth &amp; session boundary)</div>
                <div>[protocol] Preflight diff validation: 4 files changed, +142 lines, -18 lines.</div>
                <div>[protocol] Running the deep review matrix...</div>
              </div>
              <div class="p-3 rounded bg-[var(--loom-panel)] border border-[var(--loom-coral)]/40 text-[var(--loom-coral)]">
                <div class="font-bold flex items-center gap-2">
                  <span>✖</span> DEFECT DETECTED: Refresh token written to application logs
                </div>
                <div class="text-xs text-[var(--loom-text)] mt-1">
                  File: <code class="text-[var(--loom-cyan)]">src/auth/refresh.ts#L142</code>
                </div>
                <div class="text-xs text-[var(--loom-muted)] mt-1">
                  Violation: raw request metadata, including the refresh token, is passed to <code>logger.info()</code>. Breaks the repo's no-secrets-in-logs invariant.
                </div>
              </div>
              <div class="space-y-1 text-[var(--loom-muted)]">
                <div><span class="text-[var(--loom-accent)]">✔</span> Posted verified finding inline on PR #57 (commit: <code class="text-[var(--loom-text)]">4d2e1b</code>).</div>
                <div><span class="text-[var(--loom-accent)]">✔</span> Fix pushed using <code class="text-[var(--loom-text)]">redactSecrets()</code> from the shared package; thread replied and resolved.</div>
                <div class="flex items-center gap-2 text-[var(--loom-text)]">
                  <span class="braille-spinner text-[var(--loom-accent)] font-bold">⠋</span>
                  <span>hreview: starting the next pass on Gemini / Agy in pane 3...</span>
                  <span class="text-[var(--loom-muted)]">(round 2 of 4)</span>
                </div>
              </div>
            </div>

            <!-- Pane 2: Ledger -->
            <div id="pane-ledger" role="tabpanel" aria-labelledby="tab-ledger" class="tab-pane hidden space-y-3">
              <div class="text-[var(--loom-muted)] flex items-center justify-between">
                <span>PR #57 ledger &mdash; review evidence pinned to the head commit</span>
                <span class="text-[var(--loom-accent)] font-semibold">CONVERGED</span>
              </div>
              <pre class="p-4 rounded bg-[var(--loom-panel)] border border-[var(--loom-border)] text-xs text-[var(--loom-text)] overflow-x-auto leading-relaxed">&lt;!-- local-review-roster:v2 author=<span class="text-[var(--loom-cyan)]">claude</span> reviewers=<span class="text-[var(--loom-cyan)]">codex,gemini</span>
     head=<span class="text-[var(--loom-amber)]">4d2e1b89ef01a23c7b89d2140f1a94e82b7c65d3</span> supersedes=none
     declaration-sha256=<span class="text-[var(--loom-muted)]">9f3c0d…e1a7</span> --&gt;</pre>
              <div class="space-y-1 text-[var(--loom-muted)]">
                <div><span class="text-[var(--loom-accent)]">✔</span> <span class="text-[var(--loom-text)]">codex</span> attested head <code class="text-[var(--loom-amber)]">4d2e1b8</code> &middot; 1 finding fixed &middot; 0 open</div>
                <div><span class="text-[var(--loom-accent)]">✔</span> <span class="text-[var(--loom-text)]">gemini</span> attested head <code class="text-[var(--loom-amber)]">4d2e1b8</code> &middot; 0 findings</div>
                <div><span class="text-[var(--loom-accent)]">✔</span> <code class="text-[var(--loom-text)]">verify-coverage</code>: every declared reviewer attested the current head</div>
              </div>
              <div class="text-[var(--loom-muted)] text-xs">
                Herd passes are ordinary review passes, so they land in the same ledger. A new commit moves the head and invalidates only the attestations that named the old one.
              </div>
            </div>

            <!-- Pane 3: hgrill -->
            <div id="pane-grill" role="tabpanel" aria-labelledby="tab-grill" class="tab-pane hidden space-y-3">
              <div class="text-[var(--loom-muted)]">
                <span class="text-[var(--loom-cyan)] font-bold">hgrill</span> on <span class="text-[var(--loom-text)] font-semibold">issue #91</span> &gt; <span class="text-[var(--loom-text)]">"Per-tenant rate limits"</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[var(--loom-accent)] font-bold">❯</span>
                <span class="text-[var(--loom-text)] font-semibold">/hgrill 91</span>
              </div>
              <div class="space-y-1 text-[var(--loom-muted)]">
                <div>[engine 1/3] <span class="text-[var(--loom-text)]">claude</span> &middot; product-grill &middot; 9 questions settled</div>
                <div>[engine 2/3] <span class="text-[var(--loom-text)]">codex</span> &middot; grill &middot; 6 questions settled, 1 disputed</div>
                <div>[engine 3/3] <span class="text-[var(--loom-text)]">gemini</span> &middot; grill &middot; 4 questions settled</div>
                <div>[reconcile] Disputed call resolved: limits apply per API key, not per user</div>
              </div>
              <div class="p-3 rounded bg-[var(--loom-panel)] border border-[var(--loom-amber)]/40 text-[var(--loom-amber)]">
                <div class="font-bold">⚑ Assumptions posted to the top of issue #91</div>
                <div class="text-xs text-[var(--loom-muted)] mt-1">3 product calls and 5 assumptions wait for your sign-off before any build starts.</div>
              </div>
            </div>

            <!-- Pane 4: hloop -->
            <div id="pane-loop" role="tabpanel" aria-labelledby="tab-loop" class="tab-pane hidden space-y-3">
              <div class="text-[var(--loom-muted)]">
                <span class="text-[var(--loom-cyan)] font-bold">hloop</span> under <span class="text-[var(--loom-text)] font-semibold">horch</span> &middot; integration branch <code class="text-[var(--loom-amber)]">staging</code>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[var(--loom-accent)] font-bold">❯</span>
                <span class="text-[var(--loom-text)] font-semibold">/hloop next 3</span>
              </div>
              <div class="space-y-1 text-[var(--loom-muted)]">
                <div>[batch] Ready agent issues: <span class="text-[var(--loom-text)]">#88, #93, #91</span></div>
                <div>[grill] #91 has an open design &rarr; routed to the grill queue, no build</div>
                <div>[build] #88 &rarr; draft PR #58 &middot; <code class="text-[var(--loom-text)]">fix(allocator): clamp floor value to zero</code></div>
                <div>[build] #93 &rarr; draft PR #59 &middot; docs only &rarr; auto-glance</div>
                <div><span class="text-[var(--loom-accent)]">✔</span> PR #58: fresh hreview chain converged at <code class="text-[var(--loom-text)]">a71c2e0</code></div>
                <div><span class="text-[var(--loom-accent)]">✔</span> PR #59: auto-glance clean, CI green</div>
                <div><span class="text-[var(--loom-accent)]">✔</span> Shipped #58 and #59 to <code class="text-[var(--loom-amber)]">staging</code> through horch's gate</div>
              </div>
              <div class="p-2.5 rounded bg-[var(--loom-accent-glow)] border border-[var(--loom-accent)]/30 text-[var(--loom-accent)] font-bold flex items-center gap-2">
                <span>✔</span> Batch done. Promotion to production waits for you.
              </div>
            </div>

            <!-- Pane 4: Sync -->
            <div id="pane-sync" role="tabpanel" aria-labelledby="tab-sync" class="tab-pane hidden space-y-3">
              <div class="text-[var(--loom-muted)]">
                <span class="text-[var(--loom-cyan)] font-bold">sync-engine v2</span> &mdash; Fleet propagation
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[var(--loom-accent)] font-bold">❯</span>
                <span class="text-[var(--loom-text)] font-semibold">python3 scripts/sync-engine.py --upstream-repo ../activeloom --consumer-dir .</span>
              </div>
              <div class="space-y-1 text-[var(--loom-muted)]">
                <div>[sync] Source: <code class="text-[var(--loom-cyan)]">loomantix/activeloom@sync-v2</code> (commit: <code class="text-[var(--loom-text)]">986a66b</code>)</div>
                <div>[sync] Updating upstream-managed skills and review workflows:</div>
                <div class="pl-4 text-[var(--loom-text)]">
                  <div>→ <code class="text-[var(--loom-cyan)]">.agents/skills/critique/SKILL.md</code> (updated)</div>
                  <div>→ <code class="text-[var(--loom-cyan)]">.codex/REVIEW_WORKFLOW.md</code> (synced)</div>
                  <div>→ <code class="text-[var(--loom-cyan)]">.github/copilot-instructions.md</code> (re-rendered with project variables)</div>
                </div>
                <div class="pt-2 text-[var(--loom-accent)] font-semibold">
                  ★ Consumer-owned exceptions preserved without modification:
                </div>
                <div class="pl-4 text-[var(--loom-muted)]">
                  <div>✔ <code class="text-[var(--loom-text)]">.review/addendum.local.md</code> (4 local security invariants protected)</div>
                  <div>✔ <code class="text-[var(--loom-text)]">.codex/skills/agent-loop/agent-loop.config</code> (local queue config preserved)</div>
                </div>
              </div>
              <div class="text-[var(--loom-text)]">
                ✔ Opened a propagation PR for review. Consumer-owned files untouched.
              </div>
            </div>
          </div>

          <!-- Terminal Bottom Status Bar -->
          <div class="h-8 px-4 border-t border-[var(--loom-border)] bg-[var(--loom-panel)]/80 flex items-center justify-between text-[11px] font-mono text-[var(--loom-muted)]">
            <div class="flex items-center gap-2">
              <span class="text-[var(--loom-accent)] font-bold">›</span>
              <span class="terminal-cursor"></span>
            </div>
            <div class="flex items-center gap-4">
              <span>ctx: <span class="text-[var(--loom-accent)] font-semibold">4%</span> (38k / 1M)</span>
              <span class="hidden sm:inline">esc to interrupt</span>
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('[data-mock-tab]');
    const panes = document.querySelectorAll('.tab-pane');
    const spaceBtns = document.querySelectorAll('[data-mock-space]');
    const agentBtns = document.querySelectorAll('[data-mock-agent]');

    function selectTab(target) {
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-mock-tab') === target;
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        if (isMatch) {
          tab.classList.add('border-b-[var(--loom-accent)]', 'text-[var(--loom-text)]', 'font-semibold', 'bg-[var(--loom-code)]');
          tab.classList.remove('border-b-transparent', 'text-[var(--loom-muted)]');
        } else {
          tab.classList.remove('border-b-[var(--loom-accent)]', 'text-[var(--loom-text)]', 'font-semibold', 'bg-[var(--loom-code)]');
          tab.classList.add('border-b-transparent', 'text-[var(--loom-muted)]');
        }
      });

      panes.forEach((pane) => {
        if (pane.id === 'pane-' + target) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.add('hidden');
          pane.classList.remove('block');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        selectTab(tab.getAttribute('data-mock-tab'));
      });
    });

    spaceBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectTab(btn.getAttribute('data-mock-space'));
      });
    });

    agentBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectTab(btn.getAttribute('data-mock-agent'));
      });
    });

    // Braille spinner cycling
    const frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % frames.length;
      document.querySelectorAll('.braille-spinner').forEach((el) => {
        el.textContent = frames[idx];
      });
    }, 80);
  })();
</script>
