---
---

<div class="border-b border-[var(--loom-border)] bg-[var(--loom-panel)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 divide-y md:divide-y-0 md:divide-x divide-[var(--loom-border)]">
      <!-- Metric 1 -->
      <div class="pt-4 md:pt-0 md:px-6 first:pt-0 first:px-0">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--loom-accent)]">3</div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--loom-muted)] mt-1">Native Agent Harnesses</div>
        <p class="text-xs text-[var(--loom-muted)] mt-1 hidden sm:block">Claude Code, Codex, and Gemini / Antigravity from one upstream.</p>
      </div>

      <!-- Metric 2 -->
      <div class="pt-4 md:pt-0 md:px-6">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--loom-cyan)]">10+</div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--loom-muted)] mt-1">Production Skills</div>
        <p class="text-xs text-[var(--loom-muted)] mt-1 hidden sm:block">Hardened workflows for diagnosis, planning, task packets, and review.</p>
      </div>

      <!-- Metric 3 -->
      <div class="pt-4 md:pt-0 md:px-6">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--loom-amber)]">SHA</div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--loom-muted)] mt-1">Commit-Pinned Review Evidence</div>
        <p class="text-xs text-[var(--loom-muted)] mt-1 hidden sm:block">Review attestations name the exact head commit they read.</p>
      </div>

      <!-- Metric 4 -->
      <div class="pt-4 md:pt-0 md:px-6">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--loom-text)]">Apache 2.0</div>
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--loom-muted)] mt-1">Permissive Open Source</div>
        <p class="text-xs text-[var(--loom-muted)] mt-1 hidden sm:block">No SaaS seat fees, no cloud lock-in. Host and distribute freely.</p>
      </div>
    </div>
  </div>
</div>
